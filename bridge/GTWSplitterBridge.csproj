<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GTWSplitterBridge</AssemblyName>
    <RootNamespace>GTWSplitterBridge</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <!-- Referencing game assemblies produces CS1701-style warnings; harmless
         because Unity's Mono is the actual runtime. -->
    <NoWarn>MSB3277;CS0436</NoWarn>
    <GameRoot>/home/m/.local/share/Steam/steamapps/common/Get To Work</GameRoot>
    <GameManaged>$(GameRoot)/Get To Work_Data/Managed</GameManaged>
    <BepInExCore>$(GameRoot)/BepInEx/core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Isto.Core">
      <HintPath>$(GameManaged)/Isto.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
